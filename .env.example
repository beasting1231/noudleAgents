NODE_ENV=development
RELAY_HOST=0.0.0.0
RELAY_PORT=4310
RELAY_PUBLIC_URL=http://localhost:4310
RELAY_DATABASE_URL=postgres://relay:relay@localhost:55432/relay
RELAY_STORAGE_PATH=./data/artifacts
RELAY_MAX_ARTIFACT_MB=100
RELAY_SANDBOX_MANAGER_URL=http://127.0.0.1:4330
# Set to an explicitly reachable LAN/VPN host only when noVNC is intentionally exposed.
RELAY_COMPUTER_PUBLIC_HOST=
RELAY_WORKSPACE_PATH=./data/workspaces
RELAY_DEV_AUTH_TOKEN=relay-local-owner
RELAY_AGENT_API_TOKEN=relay-local-agent-token
RELAY_CODEX_BIN=codex
RELAY_CODEX_MODE=codex
RELAY_CODEX_WORKER_URL=http://127.0.0.1:4320
RELAY_INTERNAL_TOKEN=relay-local-internal-token
RELAY_AGENT_WORKSPACE_ROOT=agents
RELAY_CODEX_HOME=
RELAY_SANDBOX_MODE=local
RELAY_DOCKER_NETWORK=relay-runtime
RELAY_DOCKER_ISOLATED_NETWORK=relay-runtime-isolated
RELAY_SANDBOX_PUBLIC_URL=http://127.0.0.1:4330
RELAY_SANDBOX_VIEW_SECRET=relay-local-view-secret
RELAY_CONNECTOR_SECRET_KEY=replace-with-a-long-random-secret
RELAY_AGENT_IMAGE=relay-agent-sandbox:local
RELAY_MAX_CONCURRENT_RUNS=4
RELAY_MAX_BROWSER_RUNS=2
